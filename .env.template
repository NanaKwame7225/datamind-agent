# DataMind Agent v2 — Environment Variables
# Copy to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-32-character-string-here
DEBUG=false
ALLOWED_ORIGINS=["https://nanakwame7225.github.io","http://localhost:3000"]

# ── LLM APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
GOOGLE_API_KEY=AIza...
COHERE_API_KEY=...
MISTRAL_API_KEY=...

# ── Email (for scheduled reports) ────────────────────────────────────────────
# Gmail: enable 2FA, create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-16-chars
SMTP_FROM=DataMind Agent <your-email@gmail.com>

# ── Stripe (for payments) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── Databases ─────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://user:pass@host:5432/datamind
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
REDIS_URL=redis://localhost:6379/0

# ── Cloud Warehouses ──────────────────────────────────────────────────────────
BIGQUERY_PROJECT=your-gcp-project
SNOWFLAKE_ACCOUNT=your-account.snowflakecomputing.com
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=DATAMIND
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
